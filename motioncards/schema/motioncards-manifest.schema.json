{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kafu.invalid/motioncards/schema/v1",
  "title":"Kafu MotionCards package manifest",
  "type":"object",
  "required":["package_type","schema_version","package_id","package_revision","runtime_version","protocol_version","source","selection","animations"],
  "properties":{
    "package_type":{"const":"kafu-motioncards"},
    "schema_version":{"const":1},
    "package_id":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9-]{0,63}$"},
    "package_revision":{"type":"integer","minimum":1},
    "runtime_version":{"const":1},
    "protocol_version":{"const":1},
    "source":{
      "type":"object",
      "required":["kind","catalog_url","catalog_sha256"],
      "properties":{
        "kind":{"const":"published"},
        "catalog_url":{"type":"string","pattern":"^https://kafu-content-1\\.blsmohamme97\\.workers\\.dev/"},
        "catalog_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "index_url":{"type":["string","null"]},
        "index_sha256":{"type":["string","null"]},
        "snapshot_pinned":{"type":["boolean","null"]}
      },
      "additionalProperties":true
    },
    "selection":{
      "type":"object",
      "required":["qids","count","scope","warnings"],
      "properties":{
        "qids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^Q[0-9]{9}$"}},
        "count":{"type":"integer","minimum":1,"maximum":500},
        "scope":{"type":"object"},
        "warnings":{"type":"array"}
      },
      "additionalProperties":false
    },
    "multipart":{
      "type":["object","null"],
      "properties":{
        "part_index":{"type":"integer","minimum":1,"maximum":100},
        "total_parts":{"type":"integer","minimum":2,"maximum":100},
        "batch_count":{"type":"integer","minimum":1,"maximum":500},
        "batch_qids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^Q[0-9]{9}$"}},
        "part_qids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^Q[0-9]{9}$"}}
      },
      "required":["part_index","total_parts","batch_count","batch_qids","part_qids"],
      "additionalProperties":false
    },
    "animations":{
      "type":"array","minItems":1,"maxItems":500,
      "items":{
        "type":"object",
        "required":["book_id","book_version","chapter_id","qid","publisher_fingerprint","content_hash","content_hash_algorithm","content_hash_canonicalization","duration_ms","entry_path","entry_sha256","scene_path","scene_sha256","source_record_path","source_record_sha256","final_panel","replace"],
        "properties":{
          "book_id":{"type":"string","minLength":1},
          "book_version":{"type":"integer","minimum":1},
          "chapter_id":{"type":["string","integer"]},
          "qid":{"type":"string","pattern":"^Q[0-9]{9}$"},
          "publisher_fingerprint":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "publisher_fingerprint_source":{"type":["string","null"]},
          "content_hash":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "content_hash_algorithm":{"const":"SHA-256"},
          "content_hash_canonicalization":{"const":"kafu-question-canonical-json-v1"},
          "duration_ms":{"type":"integer","minimum":2000,"maximum":30000},
          "entry_path":{"type":"string","pattern":"^entries/Q[0-9]{9}\\.html$"},
          "entry_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "scene_path":{"type":"string","pattern":"^scenes/Q[0-9]{9}\\.scene\\.json$"},
          "scene_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "source_record_path":{"type":"string","pattern":"^source/questions/Q[0-9]{9}\\.json$"},
          "source_record_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "replace":{"type":"boolean"},
          "final_panel":{
            "type":"object",
            "required":["takeaway","correct_answer_kind","correct_answer_statements"],
            "properties":{
              "takeaway":{"type":"string","minLength":1,"maxLength":240},
              "correct_answer_kind":{"enum":["sba","emq","multi","mtf"]},
              "correct_answer_statements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
            },
            "additionalProperties":false
          }
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false
}
