{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kafu.invalid/motioncards/scene/v1",
  "title":"Kafu MotionCards declarative scene source",
  "type":"object",
  "required":["schema_version","qid","duration_ms","takeaway","layers"],
  "properties":{
    "schema_version":{"const":1},
    "qid":{"type":"string","pattern":"^Q[0-9]{9}$"},
    "duration_ms":{"type":"integer","minimum":2000,"maximum":30000},
    "takeaway":{"type":"string","minLength":1,"maxLength":240,"not":{"pattern":"^EDIT:"}},
    "replace":{"type":"boolean"},
    "custom_renderer":{"type":"string","maxLength":12000},
    "layers":{
      "type":"array","minItems":1,"maxItems":80,
      "items":{
        "type":"object",
        "required":["type"],
        "properties":{
          "type":{"enum":["label","rect","circle","arrow","path","highlight","focus"]},
          "start_ms":{"type":"integer","minimum":0},
          "end_ms":{"type":"integer","minimum":0},
          "from":{"$ref":"#/$defs/transform"},
          "to":{"$ref":"#/$defs/transform"},
          "opacity":{"type":"number","minimum":0,"maximum":1},
          "x":{"type":"number"},"y":{"type":"number"},"cx":{"type":"number"},"cy":{"type":"number"},
          "x1":{"type":"number"},"y1":{"type":"number"},"x2":{"type":"number"},"y2":{"type":"number"},
          "width":{"type":"number","minimum":0},"height":{"type":"number","minimum":0},"r":{"type":"number","minimum":0},"rx":{"type":"number","minimum":0},
          "text":{"type":"string","maxLength":120},"size":{"type":"number","minimum":1,"maximum":160},"weight":{"type":["string","number"]},"anchor":{"enum":["start","middle","end"]},
          "color":{"type":"string","maxLength":64},"stroke":{"type":"string","maxLength":64},"fill":{"type":"string","maxLength":64},"stroke_width":{"type":"number","minimum":0,"maximum":40},
          "d":{"type":"string","maxLength":2000}
        },
        "additionalProperties":false
      }
    }
  },
  "$defs":{
    "transform":{
      "type":"object",
      "properties":{"x":{"type":"number"},"y":{"type":"number"},"scale":{"type":"number","minimum":0},"rotate":{"type":"number"},"opacity":{"type":"number","minimum":0,"maximum":1}},
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
